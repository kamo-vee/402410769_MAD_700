<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SMART PANTRY" android:textColor="@color/forest"
            android:textStyle="bold" android:letterSpacing="0.14" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Good food starts with what you have."
            android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Your pantry is ready. Find a recipe you can make right now."
            android:textColor="@color/muted" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:orientation="vertical"
            android:background="@drawable/panel_background" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YOUR PANTRY" android:textColor="@color/muted" android:textSize="12sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/pantry_count" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="0 ingredients" android:textColor="@color/ink" android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/open_pantry" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="20dp"
            android:background="@drawable/button_background" android:text="Open my pantry"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <Button android:id="@+id/open_recipes" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="See recipes I can make" android:textAllCaps="false" android:textSize="16sp" />
        <Button android:id="@+id/open_settings" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="8dp"
            android:text="Settings" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Only recipes with every ingredient in sufficient quantity are suggested."
            android:textColor="@color/muted" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
