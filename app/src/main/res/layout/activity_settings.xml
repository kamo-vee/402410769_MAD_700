<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@color/surface">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kitchen" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:text="/" android:textColor="@color/border" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Preferences" android:textColor="@color/ink" android:textSize="12sp"
            android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:layout_width="30dp" android:layout_height="30dp"
            android:background="@drawable/pantry_symbol_background" android:gravity="center"
            android:text="LP" android:textColor="@color/forest" android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="28dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="6dp" android:layout_height="6dp"
                    android:background="@drawable/eyebrow_dot" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="MAKE IT YOURS"
                    android:textColor="@color/muted" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="A kitchen that\nworks your way."
                android:textColor="@color/ink" android:textSize="35sp" android:fontFamily="serif"
                android:textStyle="bold" android:lineSpacingMultiplier="0.95" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="A few small preferences make your pantry feel like home."
                android:textColor="@color/muted" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:background="@drawable/panel_background"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:padding="16dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:background="@drawable/nav_tab_selected" android:gravity="center"
                    android:text="01" android:textColor="@color/forest" android:textSize="10sp"
                    android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Gentle reminders" android:textColor="@color/ink"
                        android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="A nudge when something is nearing its best-by date."
                        android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>
                <Switch android:id="@+id/expiry_toggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="A SMALLER FOOD FOOTPRINT"
                android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"
                android:letterSpacing="0.14" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Good meals start at home."
                android:textColor="@color/ink" android:textSize="22sp" android:fontFamily="serif"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/panel_background"
                android:padding="16dp"
                android:text="MySmartPantry helps you notice what you already have and make more of it. Recipes match every ingredient and quantity, and pantry data stays on this device."
                android:textColor="@color/muted" android:textSize="12sp"
                android:lineSpacingMultiplier="1.25" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent" android:layout_height="68dp" />
</LinearLayout>
