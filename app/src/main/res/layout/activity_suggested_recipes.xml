<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@color/surface">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kitchen" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:text="/" android:textColor="@color/border" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Recipes" android:textColor="@color/ink" android:textSize="12sp"
            android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:layout_width="30dp" android:layout_height="30dp"
            android:background="@drawable/pantry_symbol_background" android:gravity="center"
            android:text="LP" android:textColor="@color/forest" android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="6dp" android:layout_height="6dp"
                    android:background="@drawable/eyebrow_dot" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="MADE FROM WHAT YOU HAVE"
                    android:textColor="@color/muted" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Tonight, sorted."
                android:textColor="@color/ink" android:textSize="34sp" android:fontFamily="serif"
                android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Every suggestion uses only ingredients already in your pantry. No hidden shopping list."
                android:textColor="@color/muted" android:textSize="12sp"
                android:lineSpacingMultiplier="1.25" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/overview_background"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="13dp">
                <TextView android:layout_width="38dp" android:layout_height="38dp"
                    android:background="@drawable/pantry_symbol_background" android:gravity="center"
                    android:text="✓" android:textColor="@color/forest" android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="STRICT PANTRY MATCH" android:textColor="@color/forest"
                        android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/recipe_count" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="10dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recipes_recycler"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:nestedScrollingEnabled="true" android:scrollbars="vertical"
                    android:clipToPadding="false" android:paddingBottom="8dp" />
                <TextView android:id="@+id/no_matches" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:background="@drawable/panel_background" android:padding="16dp"
                    android:text="No exact matches yet. Add ingredients to see what you can make."
                    android:textColor="@color/muted" android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    <include layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent" android:layout_height="68dp" />
</LinearLayout>
