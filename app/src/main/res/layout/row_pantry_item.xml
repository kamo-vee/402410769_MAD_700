<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/pantry_row_background" android:gravity="center_vertical"
    android:orientation="horizontal" android:minHeight="65dp"
    android:paddingTop="9dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/item_symbol" android:layout_width="36dp"
        android:layout_height="36dp" android:background="@drawable/pantry_symbol_background"
        android:gravity="center" android:textColor="@color/forest" android:textSize="14sp"
        android:textStyle="bold" android:fontFamily="serif" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/item_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/ink"
            android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/item_amount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="@color/forest" android:textSize="10sp" />
        <TextView android:id="@+id/item_expiry" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textColor="@color/muted" android:textSize="9sp" />
    </LinearLayout>
    <Button android:id="@+id/edit_item" android:layout_width="wrap_content"
        android:layout_height="36dp" android:minWidth="42dp" android:insetLeft="0dp"
        android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
        android:background="@drawable/nav_tab_unselected" android:text="Edit"
        android:textAllCaps="false" android:textColor="@color/muted" android:textSize="10sp" />
    <Button android:id="@+id/delete_item" android:layout_width="wrap_content"
        android:layout_height="36dp" android:minWidth="42dp" android:insetLeft="0dp"
        android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
        android:background="@drawable/nav_tab_unselected" android:text="Del"
        android:textAllCaps="false" android:textColor="@color/terracotta" android:textSize="10sp" />
</LinearLayout>
