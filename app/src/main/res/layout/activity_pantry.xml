<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="@color/surface">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kitchen" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:text="/" android:textColor="@color/border" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Pantry" android:textColor="@color/ink" android:textSize="12sp"
            android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:layout_width="30dp" android:layout_height="30dp"
            android:background="@drawable/pantry_symbol_background" android:gravity="center"
            android:text="LP" android:textColor="@color/forest" android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="6dp" android:layout_height="6dp"
                    android:background="@drawable/eyebrow_dot" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="YOUR SHELVES, AT A GLANCE"
                    android:textColor="@color/muted" android:textSize="9sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Good things\nare already here."
                android:textColor="@color/ink" android:textSize="34sp" android:fontFamily="serif"
                android:textStyle="bold" android:lineSpacingMultiplier="0.94" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Keep track of what’s in your kitchen. We’ll help you turn it into something lovely."
                android:textColor="@color/muted" android:textSize="12sp"
                android:lineSpacingMultiplier="1.25" />
            <Button android:id="@+id/add_ingredient" android:layout_width="match_parent"
                android:layout_height="42dp" android:layout_marginTop="14dp"
                android:background="@drawable/button_background" android:text="+   Add an ingredient"
                android:textAllCaps="false" android:textColor="@color/cream"
                android:textSize="12sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/overview_background"
                android:gravity="center_vertical" android:minHeight="88dp"
                android:orientation="horizontal" android:paddingStart="15dp"
                android:paddingEnd="15dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="IN YOUR PANTRY" android:textColor="@color/muted"
                        android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    <TextView android:id="@+id/pantry_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="00" android:textColor="@color/forest" android:textSize="28sp"
                        android:textStyle="bold" android:fontFamily="serif" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ingredients on hand" android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="54dp"
                    android:background="@color/sage_line" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:paddingStart="15dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="READY TO MAKE" android:textColor="@color/muted"
                        android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    <TextView android:id="@+id/recipe_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="00" android:textColor="@color/forest" android:textSize="28sp"
                        android:textStyle="bold" android:fontFamily="serif" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="recipes match exactly" android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="17dp" android:text="THE INVENTORY"
                android:textColor="@color/muted" android:textSize="9sp" android:textStyle="bold"
                android:letterSpacing="0.15" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="What’s in the kitchen"
                android:textColor="@color/ink" android:textSize="24sp" android:fontFamily="serif"
                android:textStyle="bold" />
            <EditText android:id="@+id/pantry_search" android:layout_width="match_parent"
                android:layout_height="40dp" android:layout_marginTop="9dp"
                android:background="@drawable/input_background" android:drawableStart="@drawable/ic_search"
                android:drawablePadding="9dp" android:hint="Find an ingredient"
                android:inputType="text" android:paddingStart="11dp" android:paddingEnd="11dp"
                android:singleLine="true" android:textColor="@color/ink"
                android:textColorHint="@color/muted" android:textSize="11sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="7dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/pantry_recycler"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:nestedScrollingEnabled="true" android:scrollbars="vertical"
                    android:clipToPadding="false" android:paddingBottom="8dp" />
                <TextView android:id="@+id/pantry_empty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:background="@drawable/panel_background" android:padding="16dp"
                    android:text="Nothing by that name. Try another search."
                    android:textColor="@color/muted" android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    <include layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent" android:layout_height="68dp" />
</LinearLayout>
